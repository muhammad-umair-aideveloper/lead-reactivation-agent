# ─────────────────────────────────────────────
# Lead Reactivation Agent v2 — Environment Config
# ─────────────────────────────────────────────

# ── Google Gemini (Primary LLM) ──────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Anthropic Claude (Backup LLM) ────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── LLM Strategy ─────────────────────────────
LLM_PRIMARY=gemini
LLM_FAILOVER_ENABLED=true
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_MS=60000

# ── Twilio ───────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Webhook (public URL, e.g. via ngrok) ─────
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io

# ── Redis (BullMQ) ───────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Server ───────────────────────────────────
PORT=3000

# ── Safety ───────────────────────────────────
DRY_RUN=true

# ── Business Hours (24h format, local time) ──
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17

# ── Lead timeout (hours) ─────────────────────
LEAD_TIMEOUT_HOURS=72

# ── AI concurrency (parallel LLM calls) ──────
AI_CONCURRENCY=5

# ── HITL Escalation ──────────────────────────
CONFIDENCE_THRESHOLD=0.8

# ── Cost Tracking (in cents) ─────────────────
COST_PER_SMS_CENTS=0.79
COST_PER_AI_CALL_CENTS=0.10

# ── RAG Vector Memory ────────────────────────
RAG_CONTEXT_FILE=data/business_context.json
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.3
